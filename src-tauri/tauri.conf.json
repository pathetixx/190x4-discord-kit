{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "190x4 Discord Kit",
  "mainBinaryName": "190x4-discord-kit",
  "version": "0.1.0",
  "identifier": "pw.x190x4.discordkit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "190x4",
    "copyright": "© 2026 pathetixx · 190x4",
    "shortDescription": "BetterDiscord + тема и плагины 190x4 в один клик",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4RTJFOEVBNzg2MEY0RTgKUldUbzlHQjQ2dWppdU55QitUWHBPcHkySFJ6dnhUR0ZNOEVtYjNaa2RmVEhZbzZjeHVBOXVZZU8K",
      "endpoints": [
        "https://github.com/pathetixx/190x4-discord-kit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
